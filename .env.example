# Solo ejemplos. Las credenciales locales se guardan en .env.local (ignorado por Git).
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/petshop
APP_URL=http://localhost:3000

# Seed de dos cuentas de prueba; usa correos distintos y contraseñas de 12 a 128 caracteres.
SEED_USER_EMAIL=usuario@example.test
SEED_USER_PASSWORD=CAMBIAR_CONTRASENA_USUARIO
SEED_ADMIN_EMAIL=administrador@example.test
SEED_ADMIN_PASSWORD=CAMBIAR_CONTRASENA_ADMIN

# Google Cloud: cliente OAuth de aplicación web. Vacíos hasta obtener valores reales.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback local a registrar: http://localhost:3000/api/auth/google/callback
# El callback se calcula desde APP_URL; en producción usa HTTPS.
# Checkout: solo nombres; configurar los valores reales en el servidor.
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
WOMPI_MODE=
WOMPI_ENABLE_LIVE_PAYMENTS=
GOOGLE_MAPS_API_KEY=
SHIPPING_RATES_JSON=
PICKUP_FEE_CENTS=
PICKUP_INSTRUCTIONS=
CHECKOUT_RESERVATION_MINUTES=
CHECKOUT_JOB_SECRET=
