{
  "name": "lilac-toffee-petshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "predev": "npm run assets",
    "dev": "next dev",
    "prebuild": "npm run assets",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "test:smoke": "node scripts/smoke.mjs",
    "test:public-design": "node scripts/verify-public-design.mjs",
    "db:configure": "node scripts/database/configure.mjs",
    "db:create": "node scripts/database/create.mjs",
    "db:migrate": "node scripts/database/migrate.mjs",
    "db:check": "node scripts/database/check.mjs",
    "db:seed": "node --import tsx scripts/database/seed.ts",
    "db:catalog": "node --import tsx scripts/database/catalog.ts",
    "test:auth": "node --import tsx scripts/test-auth.ts",
    "test:auth-origins": "node --import tsx scripts/test-auth-origins.ts",
    "test:dashboard": "node --import tsx scripts/test-dashboard.ts",
    "test:inventory": "node --import tsx scripts/test-inventory.ts",
    "checkout:reconcile": "node --import tsx scripts/checkout-reconcile.ts",
    "test:checkout": "node --import tsx scripts/test-checkout.ts"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@next/env": "^16.4.5",
    "argon2": "^0.45.2",
    "jose": "^6.2.16",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
